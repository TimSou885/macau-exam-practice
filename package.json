{
  "name": "430-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "build:supabase": "vite build --mode supabase",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "seed:generate": "node scripts/generate-seed-sql.mjs",
    "db:migrate:local": "wrangler d1 migrations apply macau-exam-practice --local",
    "db:seed:local": "wrangler d1 execute macau-exam-practice --local --file=scripts/seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply macau-exam-practice --remote",
    "db:seed:remote": "wrangler d1 execute macau-exam-practice --remote --file=scripts/seed.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.3",
    "vite": "^6.0.3",
    "wrangler": "^4.14.0"
  }
}
